#!/bin/sh

# REF: https://community.grommunio.com/d/2671-checkmk-script-fur-quotenuberwachung

CHECK="EXMDB"
active_users=$(gromox-mbop foreach.here.mb.active echo-username)
# UMLAUTE CAN MAKE THINGS BREAK SO FOR NOW JUST QUERY DATA THAT ONLY HAS NUMBERS!
#STUFF="$(grommunio-admin taginfo '*' |grep -v 'string8' | awk '{gsub(/,/,"", $3); printf "%s ", tolower($3)}')";
STUFF="associatedcontentcount assocmessagesizeextended contentcount creationtime deletedassocmsgcount deletedmsgcount displaytypeex messagesizeextended normalmessagesizeextended outofofficestate prohibitreceivequota prohibitsendquota storagequotalimit storestate"

# BULK QUERY EVERYTHING WE CAN GET
JSON=$(mktemp -t exmdb.XXXXX)
trap 'rm $JSON' INT QUIT TERM EXIT
(
  for user in $active_users; do
    printf "exmdb %s store get %s --format=json-kv\n" "$user" "$STUFF"
  done | grommunio-admin shell -n  2>/dev/null | sed '/^$/d' | awk '{
    if ($1=="exmdb") { mailbox=$2 }
    else if ($1=="tag" && $2=="value") {next}
    else { printf "%s\t%s\n", mailbox, $0 }
    }' | while read -r username json; do
    #}' | while IFS="$(printf '\t')" read -r username json; do
## DIFFERENT OUTPUT FORMAT
##  jq --null-input --arg username "$username" \
##    --argjson dump "$json" '{$username: $dump}'
  jq --null-input --arg username "$username" \
    --argjson dump "$json" '{mbx: $username, exmdb: $dump}'
  done
) | jq --slurp > "$JSON" || exit 1
