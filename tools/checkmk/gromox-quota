# MBX:cb@clownflare.de=1057890842;1887436800;;1782579200
jq --arg check "$CHECK" ' . [] | 
  {username: .mbx}  + 
    ( .exmdb| 
      ( pick  
        ( .storagequotalimit, .prohibitsendquota, .prohibitreceivequota, .messagesizeextended ) 
      ) ) 
      | ( "P \"" + $check + " " + .username + "\" size=" + 
      (( .messagesizeextended / 1024 / 1024 | floor ) | tostring ) + ";" + 
      ((( .prohibitsendquota // 0 ) / 1024| floor ) | tostring ) + ";" + 
      ((( .prohibitreceivequota // 0 ) / 1024 | floor ) | tostring ) + ";" + 
      ((( .storagequotalimit // 0 ) / 1024 | floor ) | tostring )  ) 
  ' -r "$JSON"


